# Configurações da Aplicação
FLASK_SECRET_KEY=your-super-secret-key-here-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=False

# Configurações do Banco de Dados
DATABASE_URL=sqlite:///users.db

# Configurações de Sessão
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Configurações do Servidor
HOST=0.0.0.0
PORT=5000

# Configurações AWS (apenas para produção)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_ECR_REGISTRY=your-ecr-registry-url
AWS_ECR_REPOSITORY=your-repository-name

# Configurações de Segurança
BCRYPT_LOG_ROUNDS=12

# Configurações do Administrador Padrão
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_FULLNAME=Administrador do Sistema
ADMIN_PHONE=(00) 00000-0000